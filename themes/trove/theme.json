{
  "name": "Trove",
  "version": "1.0.0",
  "author": "Hyper Trove × multitenantcom",
  "description": "High-volume food & packaging storefront inspired by Hyper Trove: announcement bar, mega category tiles, grid/rail shelves, quick-view cards, B2B promo band and FAQ.",
  "settings": [
    { "type": "header", "label": "Colours and type" },
    { "id": "primary", "type": "color", "label": "Main colour", "default": "#CB321E" },
    { "id": "accent", "type": "color", "label": "Highlight", "default": "#FEC61F" },
    { "id": "background", "type": "color", "label": "Background", "default": "#F0F0F0" },
    { "id": "surface", "type": "color", "label": "Cards", "default": "#FFFFFF" },
    { "id": "text", "type": "color", "label": "Text", "default": "#000000" },
    { "id": "font", "type": "font", "label": "Font", "default": "Poppins" },
    { "id": "radius", "type": "range", "label": "Corner roundness", "min": 0, "max": 28, "step": 1, "default": 10 },
    { "id": "logo", "type": "image", "label": "Logo", "info": "Square image link (https://)", "default": "" },

    { "type": "header", "label": "Top announcement bar" },
    { "id": "announcement_tag", "type": "text", "label": "Badge label", "info": "Short tag like NEW or B2B", "default": "WHOLESALE" },
    { "id": "announcement", "type": "text", "label": "Message across the top", "info": "Leave empty to hide it", "default": "Same-day dispatch on in-stock food packaging orders before 14:00." },

    { "type": "header", "label": "Hero banner" },
    { "id": "hero_badge", "type": "text", "label": "Eyebrow badge", "default": "Food-grade & Eco-ready" },
    { "id": "hero_title", "type": "text", "label": "Headline", "info": "Leave empty to show your store name", "default": "Packaging built for busy kitchens." },
    { "id": "hero_text", "type": "textarea", "label": "Text under the headline", "info": "Leave empty to show your store description", "default": "" },
    { "id": "hero_button", "type": "text", "label": "Button", "default": "Shop catalog" },
    { "id": "hero_image", "type": "image", "label": "Banner picture", "info": "Upload an asset or paste an https:// link", "default": "asset:hero.webp" },
    { "id": "banner_1_image", "type": "image", "label": "Small banner 1", "default": "asset:banner-2.jpg" },
    { "id": "banner_2_image", "type": "image", "label": "Small banner 2", "default": "asset:banner-1.jpg" },
    { "id": "banner_3_image", "type": "image", "label": "Small banner 3", "default": "asset:banner-3.jpg" },
    { "id": "promo_image", "type": "image", "label": "Promo banner picture", "default": "asset:promo-banner.webp" },
    { "id": "sale_card_1", "type": "image", "label": "Sale card 1", "default": "asset:sale-banner-card-1.webp" },
    { "id": "sale_card_2", "type": "image", "label": "Sale card 2", "default": "asset:sale-banner-card-2.webp" },
    { "id": "logo_footer", "type": "image", "label": "Footer logo", "default": "asset:trove-logo-footer.png" },
    { "id": "box_icon_1", "type": "image", "label": "Perk icon 1", "default": "asset:box-icon-1.webp" },
    { "id": "box_icon_2", "type": "image", "label": "Perk icon 2", "default": "asset:box-icon-2.webp" },
    { "id": "box_icon_3", "type": "image", "label": "Perk icon 3", "default": "asset:box-icon-3.webp" },
    { "id": "show_tiles", "type": "checkbox", "label": "Show Top Categories sidebar & small banners", "default": true },

    { "type": "header", "label": "Catalog layout" },
    { "id": "columns", "type": "select", "label": "Desktop cards per row", "options": [{ "value": "3", "label": "3 columns" }, { "value": "4", "label": "4 columns" }, { "value": "5", "label": "5 columns" }], "default": "4" },
    { "id": "shelf_style", "type": "select", "label": "Category shelf style", "options": [{ "value": "grid", "label": "Responsive grid" }, { "value": "rail", "label": "Horizontal swipe rail" }], "default": "grid" },

    { "type": "header", "label": "Trust & perks strip" },
    { "id": "perk_1", "type": "text", "label": "Perk 1", "default": "Food-grade certified materials" },
    { "id": "perk_2", "type": "text", "label": "Perk 2", "default": "Volume tiers & B2B pricing" },
    { "id": "perk_3", "type": "text", "label": "Perk 3", "default": "Multi-warehouse fast shipping" },
    { "id": "perk_4", "type": "text", "label": "Perk 4", "default": "QRIS, VA & instant checkout" },

    { "type": "header", "label": "Wholesale promo banner" },
    { "id": "promo_badge", "type": "text", "label": "Promo eyebrow", "default": "CUSTOM & BULK" },
    { "id": "promo_title", "type": "text", "label": "Headline", "info": "Leave empty to hide the band", "default": "Need custom logo printing or bulk cartons?" },
    { "id": "promo_text", "type": "textarea", "label": "Text", "default": "Talk to our packaging team for wholesale rates, sample kits, and scheduled restocks." },

    { "type": "header", "label": "FAQ accordion" },
    { "id": "show_faq", "type": "checkbox", "label": "Show FAQ section", "default": true },
    { "id": "faq_title", "type": "text", "label": "FAQ heading", "default": "Frequently asked questions" },
    { "id": "faq_1_q", "type": "text", "label": "Question 1", "default": "Do you offer bulk or wholesale discounts?" },
    { "id": "faq_1_a", "type": "textarea", "label": "Answer 1", "default": "Yes! Volume discounts apply automatically in your cart for 10+ packs, and registered B2B accounts receive 15% off." },
    { "id": "faq_2_q", "type": "text", "label": "Question 2", "default": "Are your boxes and bowls microwave-safe and food-grade?" },
    { "id": "faq_2_a", "type": "textarea", "label": "Answer 2", "default": "All food-contact containers are BPA-free, food-grade certified, and leak-resistant for hot and cold deliveries." },
    { "id": "faq_3_q", "type": "text", "label": "Question 3", "default": "How fast is delivery or pickup?" },
    { "id": "faq_3_a", "type": "textarea", "label": "Answer 3", "default": "Orders ship from the nearest stocked warehouse for same-day courier delivery or instant store pickup." }
  ]
}
